# Required for embeddings, evaluation, and answer generation
OPENAI_API_KEY=

# Required only when the local evidence is insufficient and web fallback is used
TAVILY_API_KEY=

# Models are intentionally configurable. Replace them if your account uses other models.
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional custom OpenAI-compatible endpoint.
# For the standard OpenAI API, leave this variable UNSET rather than assigning
# an empty value. Example for a compatible custom endpoint:
# OPENAI_BASE_URL=http://localhost:11434/v1

# Local paths
GAMESCOPE_DATA_DIR=data/games
GAMESCOPE_CHROMA_DIR=.chroma
GAMESCOPE_COLLECTION=gamescope
